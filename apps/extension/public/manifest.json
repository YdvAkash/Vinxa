{
  "manifest_version": 3,
  "name": "Vinxa Live — AI Meeting Intelligence",
  "version": "1.0.0",
  "description": "Enterprise AI meeting intelligence assistant for Google Meet, Microsoft Teams web, and Zoom web.",
  "permissions": [
    "tabCapture",
    "audioCapture",
    "offscreen",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "http://localhost:8080/*",
    "ws://localhost:8080/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vinxa Live"
  },
  "background": {
    "service_worker": "src/background/service-worker.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*"
      ],
      "js": ["src/content/detector-content.ts"],
      "run_at": "document_end"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "Vinxa Live — AI Meeting Intelligence",
  "version": "1.0.0",
  "description": "Enterprise AI meeting intelligence assistant for Google Meet, Microsoft Teams web, and Zoom web.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "https://teams.microsoft.com/*",
    "https://*.teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://zoom.us/*",
    "https://*.zoom.us/*",
    "http://vinxa.ogakash.xyz/*",
    "https://vinxa.ogakash.xyz/*",
    "http://api.vinxa.ogakash.xyz/*",
    "https://api.vinxa.ogakash.xyz/*",
    "ws://api.vinxa.ogakash.xyz/*",
    "wss://api.vinxa.ogakash.xyz/*",
    "http://*.ogakash.xyz/*",
    "https://*.ogakash.xyz/*",
    "http://13.237.88.27/*",
    "ws://13.237.88.27/*",
    "http://localhost:5173/*",
    "http://localhost:8080/*",
    "ws://localhost:8080/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Vinxa Live"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://teams.microsoft.com/*",
        "https://*.teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://zoom.us/*",
        "https://*.zoom.us/*",
        "http://api.vinxa.ogakash.xyz/*",
        "https://api.vinxa.ogakash.xyz/*",
        "http://*.ogakash.xyz/*",
        "https://*.ogakash.xyz/*",
        "http://13.237.88.27/*",
        "http://localhost:5173/*",
        "http://*/*",
        "https://*/*"
      ],
      "js": ["detector-content.js"],
      "run_at": "document_end"
    }
  ]
}
